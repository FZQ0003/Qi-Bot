{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "Bot Protocol Config",
  "description": "机器人协议配置",
  "$defs": {
    "qq": {
      "type": "integer",
      "minimum": 10000,
      "maximum": 9999999999
    },
    "web": {
      "type": "object",
      "properties": {
        "adapter": {
          "description": "Web API 通信方式",
          "enum": [
            "http",
            "webhook",
            "ws",
            "ws-reverse"
          ],
          "default": "ws"
        },
        "access_token": {
          "description": "Web API 访问令牌",
          "type": "string",
          "default": "ServiceVerifyKey"
        },
        "url": {
          "description": "Web API 服务运行的地址",
          "type": "string",
          "format": "uri",
          "default": "localhost"
        },
        "host": {
          "description": "Web API 服务运行的主机名/IP",
          "type": "string",
          "pattern": "^(xn--[a-zA-Z\\d]+|[+\\w~]+)(.(xn--[a-zA-Z\\d]+|[+\\w~]+))*$",
          "default": "localhost"
        },
        "port": {
          "description": "Web API 服务运行的端口",
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 8080
        },
        "path": {
          "description": "Web API 资源路径",
          "type": "string",
          "default": "/"
        }
      },
      "anyOf": [
        {
          "required": [
            "url"
          ]
        },
        {
          "required": [
            "host",
            "port"
          ]
        }
      ]
    }
  },
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "protocol": {
        "description": "协议名称"
      }
    },
    "required": [
      "protocol"
    ],
    "anyOf": [
      {
        "properties": {
          "protocol": {
            "const": "console"
          }
        }
      },
      {
        "$ref": "#/$defs/web",
        "properties": {
          "protocol": {
            "const": "mirai-api-http"
          },
          "account": {
            "description": "机器人 QQ",
            "anyOf": [
              {
                "$ref": "#/$defs/qq"
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/qq"
                }
              }
            ],
            "default": 1234567890
          }
        },
        "required": ["account"]
      },
      {
        "$ref": "#/$defs/web",
        "properties": {
          "protocol": {
            "const": "onebot-11"
          }
        }
      }
    ]
  }
}
